{
  "fe": {
    "install": "npm ci",
    "start": "npm run build && for py in python3.13 python3.12 python3.11 python3.10 python3; do command -v $py >/dev/null && break; done; exec $py deploy/dev_server.py 8197",
    "url": "http://127.0.0.1:8197",
    "ready": "/",
    "readyTimeoutSec": 120
  },
  "be": {
    "start": "mkdir -p /tmp/syung-qa && for py in python3.13 python3.12 python3.11 python3.10 python3; do command -v $py >/dev/null && break; done; exec $py server/subway_live_proxy.py",
    "url": "http://127.0.0.1:3193",
    "ready": "/health",
    "readyTimeoutSec": 60,
    "env": {
      "SUBWAY_LIVE_HOST": "127.0.0.1",
      "SUBWAY_LIVE_PORT": "3193",
      "SUBWAY_LIVE_QUIET_HOURS": "00:00-24:00",
      "SUBWAY_LIVE_BURST_EVERY": "0",
      "SUBWAY_LIVE_PROBE_EVERY": "0",
      "SUBWAY_LIVE_STATION_PROBE": "",
      "SUBWAY_LIVE_RESPONSE_SECONDS": "0",
      "SUBWAY_LIVE_QUOTA_FILE": "/tmp/syung-qa/quota.json",
      "SUBWAY_LIVE_SAMPLES_DIR": "/tmp/syung-qa/samples",
      "SUBWAY_LIVE_HEALTH_DIR": "/tmp/syung-qa/health-days",
      "SUBWAY_LIVE_BURST_DIR": "/tmp/syung-qa/position",
      "SUBWAY_LIVE_STATION_PROBE_DIR": "/tmp/syung-qa/station-probe",
      "BUS_LIVE_MODE": "mock",
      "BUS_LIVE_RECORD_DIR": "",
      "BUS_LIVE_QUOTA_FILE": "/tmp/syung-qa/bus-quota.json",
      "BUS_ARRIVAL_QUOTA_FILE": "/tmp/syung-qa/bus-arrival-quota.json",
      "KAKAO_REST_KEY": "",
      "KMA_SERVICE_KEY": "",
      "SEOUL_BUS_SERVICE_KEY": "",
      "OSRM_URL": "http://127.0.0.1:9",
      "JOURNEY_WORKERS": "1",
      "SYUNG_AUTH_FILE": "/tmp/syung-qa/no-owner.json",
      "SYUNG_DEBUG_DIR": "/tmp/syung-qa/debug",
      "SYUNG_MEMBER_DB": "/tmp/syung-qa/members.sqlite3",
      "KAKAO_LOGIN": "0",
      "KAKAO_ADMIN_KEY": "qa-local-fake",
      "KAKAO_APP_ID": "",
      "GOOGLE_CLIENT_ID": "qa-local-fake",
      "GOOGLE_CLIENT_SECRET": "qa-local-fake",
      "APPLE_CLIENT_ID": "",
      "APPLE_CLIENT_SECRET": ""
    }
  }
}
