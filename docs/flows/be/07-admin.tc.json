{
  "cases": [
    {
      "id": "ADMIN-1",
      "branch": "문지기 페이지 쿠키 없음",
      "title": "기본 주소는 302",
      "request": {
        "method": "GET",
        "path": "/auth"
      },
      "expect": {
        "status": 302
      }
    },
    {
      "id": "ADMIN-2",
      "branch": "문지기 자료 쿠키 없음",
      "title": "json 은 401",
      "request": {
        "method": "GET",
        "path": "/auth",
        "headers": {
          "X-Forwarded-Uri": "/admin/learning.json"
        }
      },
      "expect": {
        "status": 401,
        "body": {
          "ok": false,
          "error": "login"
        }
      }
    },
    {
      "id": "ADMIN-3",
      "branch": "밖으로 보내는 next",
      "title": "밖 주소도 302",
      "request": {
        "method": "GET",
        "path": "/auth",
        "headers": {
          "X-Forwarded-Uri": "//evil.example"
        }
      },
      "expect": {
        "status": 302
      }
    },
    {
      "id": "ADMIN-4",
      "branch": "주인 쿠키 맞음",
      "manual": "주인 쿠키가 필요하다"
    },
    {
      "id": "ADMIN-5",
      "branch": "로그인 본문 없음",
      "title": "본문 없으면 413",
      "request": {
        "method": "POST",
        "path": "/login"
      },
      "expect": {
        "status": 413,
        "body": {
          "error": {
            "code": "too_large",
            "message": "본문이 없거나 너무 커요"
          }
        }
      }
    },
    {
