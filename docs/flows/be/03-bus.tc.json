{
  "cases": [
    {
      "id": "BUS-1",
      "branch": "주소 너무 김",
      "title": "2048자 넘으면 400",
      "request": {
        "method": "GET",
        "path": "/api/bus/live?"
      },
      "expect": {
        "status": 400,
        "body": {
          "ok": false,
          "error": "invalid_request"
        }
      }
    },
    {
      "id": "BUS-2",
      "branch": "노선 없이 부름",
      "title": "옛 주소 빈 위치",
      "request": {
        "method": "GET",
        "path": "/bus/live"
      },
      "expect": {
        "status": 200,
        "body": {
          "schemaVersion": 1,
          "ok": true,
          "mode": "mock",
          "busCount": 0
        },
        "shape": {
          "buses": "array",
          "routes": "object",
          "quota": "object",
          "errors": "array",
          "pollAfterSeconds": "number"
        }
      }
    },
    {
      "id": "BUS-3",
      "branch": "노선 지정",
      "title": "가짜 위치",
      "request": {
        "method": "GET",
        "path": "/api/bus/live?routes=100000020&focus=100000020"
      },
      "expect": {
        "status": 200,
        "body": {
          "schemaVersion": 1,
          "ok": true,
          "mode": "mock"
        },
        "shape": {
          "busCount": "number",
          "buses": [
            {
              "id": "string",
              "routeId": "string",
              "lng": "number",
              "lat": "number"
            }
          ]
        }
      }
    },
    {
      "id": "BUS-4",
      "branch": "모르는 노선",
      "title": "글자 노선은 400",
      "request": {
        "method": "GET",
        "path": "/api/bus/live?routes=abc"
      },
      "expect": {
        "status": 400,
        "body": {
          "schemaVersion": 1,
          "ok": false,
          "error": "invalid_request",
          "message": "routes must contain at most 8 known route IDs; focus must be one of them"
        }
      }
    },
    {
      "id": "BUS-5",
      "branch": "focus 가 routes 밖",
      "title": "focus 가 밖이면 400",
      "request": {
        "method": "GET",
        "path": "/api/bus/live?routes=100000020&focus=100000024"
      },
      "expect": {
        "status": 400,
        "body": {
          "schemaVersion": 1,
          "ok": false,
          "error": "invalid_request",
          "message": "routes must contain at most 8 known route IDs; focus must be one of them"
        }
      }
    },
    {
      "id": "BUS-6",
      "branch": "정류장 지정",
      "title": "가짜 도착",
      "request": {
        "method": "GET",
        "path": "/api/bus/live?stop=01001"
      },
      "expect": {
        "status": 200,
        "body": {
          "mode": "mock",
          "stop": "01001"
        },
        "shape": {
          "status": "string",
          "arrivals": [
            {
              "routeId": "string",
              "name": "string",
              "type": "string",
              "direction": "string",
              "buses": "array"
            }
          ]
        }
      }
    },
    {
      "id": "BUS-7",
      "branch": "모르는 정류장",
      "title": "없는 번호는 400",
      "request": {
        "method": "GET",
        "path": "/api/bus/live?stop=99999"
      },
      "expect": {
        "status": 400,
        "body": {
          "schemaVersion": 1,
          "ok": false,
          "error": "invalid_request",
          "message": "stop must be one known 5-digit stop number"
        }
      }
    },
    {
      "id": "BUS-8",
      "branch": "정류장과 노선 같이",
      "title": "같이 보내면 400",
      "request": {
        "method": "GET",
        "path": "/api/bus/live?stop=01001&routes=100000020"
      },
      "expect": {
        "status": 400,
        "body": {
          "schemaVersion": 1,
          "ok": false,
          "error": "invalid_request",
          "message": "stop must be one known 5-digit stop number"
        }
      }
    },
    {
      "id": "BUS-9",
      "branch": "실제 위치",
