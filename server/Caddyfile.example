# Static map + live-train proxy (production: syung.novum-lab.com)
syung.novum-lab.com {
	encode zstd gzip
	# bus: handled by the existing proxy, with its own cache and daily budget.
	handle /api/bus/live {
		rewrite * /bus/live
		reverse_proxy 127.0.0.1:3113
	}
	handle /api/live {
		rewrite * /live
		reverse_proxy 127.0.0.1:3113
	}
	handle {
		root * /var/www/syung
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		file_server
	}
}
