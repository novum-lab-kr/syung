# Add to /etc/subway-live.env when using the existing subway-live service.
# data.go.kr, Seoul bus position service 15000332. Encoded/decoded keys both work.
SEOUL_BUS_SERVICE_KEY=
# auto: live with a key, unavailable without one. mock must be explicitly selected.
BUS_LIVE_MODE=auto
# 운영 계정(하루 10,000번)에 맞춘 값 — 개발 계정 키(하루 1,000번)면 950
BUS_LIVE_DAILY_LIMIT=9500
# 정류장 도착(정류소정보조회 getStationByUid) 하루 한도 — 2026-11-08 운영계정 승인(하루 10,000번), 개발 계정이면 950
BUS_ARRIVAL_DAILY_LIMIT=9500
BUS_LIVE_CACHE_SECONDS=30
# Hide cached vehicle positions after 5 minutes, even during upstream failure.
BUS_LIVE_STALE_SECONDS=300
BUS_LIVE_MIN_INTERVAL=1
BUS_LIVE_TIMEOUT=8
BUS_LIVE_QUOTA_FILE=/var/lib/subway-live/bus-quota.json
# Only for standalone server/bus_live_proxy.py (integration uses port 3113).
BUS_LIVE_HOST=127.0.0.1
BUS_LIVE_PORT=3114
