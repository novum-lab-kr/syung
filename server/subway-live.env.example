# Copy to /etc/subway-live.env (never commit the real key)
SEOUL_SUBWAY_API_KEY=your-seoul-open-data-key
SUBWAY_LIVE_CACHE_SECONDS=90
SUBWAY_LIVE_DAILY_LIMIT=950
# SUBWAY_LIVE_SOURCE=all   # all = one all-lines arrival call per cache period (default); anything else = per-line positions
# SUBWAY_ALERT_WEBHOOK=https://hooks.slack.com/services/...   # optional: health alerts
