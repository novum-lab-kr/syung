# Copy to /etc/subway-live.env (never commit the real key)
SEOUL_SUBWAY_API_KEY=your-seoul-open-data-key
SUBWAY_LIVE_CACHE_SECONDS=60        # one all-lines call per this many seconds (min 60)
SUBWAY_LIVE_DAILY_LIMIT=950         # calls per Korean day; raise when the key's quota is raised
# SUBWAY_LIVE_QUIET_HOURS=01:30-05:15   # KST, no upstream calls (no trains); empty = always call
# SUBWAY_LIVE_SOURCE=all   # all = one all-lines arrival call per cache period (default); anything else = per-line positions
# SUBWAY_ALERT_WEBHOOK=https://hooks.slack.com/services/...   # optional: health alerts
# SUBWAY_LIVE_BURST_LINES=2호선,5호선,6호선,7호선,9호선   # position-feed bursts for learning dwell times
# SUBWAY_LIVE_BURST_EVERY=7200   # seconds between bursts (8 calls each); 0 = off
