# Copy to /etc/subway-live.env (never commit the real key)
SEOUL_SUBWAY_API_KEY=your-seoul-open-data-key
SUBWAY_LIVE_CACHE_SECONDS=60        # one all-lines call per this many seconds (min 60)
SUBWAY_LIVE_DAILY_LIMIT=950         # calls per Korean day; raise when the key's quota is raised
# SUBWAY_LIVE_QUIET_HOURS=01:30-05:15   # KST, no upstream calls (no trains); empty = always call
# SUBWAY_LIVE_SOURCE=all   # all = one all-lines arrival call per cache period (default); anything else = per-line positions
# SUBWAY_ALERT_WEBHOOK=https://hooks.slack.com/services/...   # optional: health alerts
# SUBWAY_LIVE_BURST_LINES=2호선,5호선,6호선,7호선,9호선   # position-feed bursts for learning dwell times
# SUBWAY_LIVE_BURST_EVERY=7200   # seconds between bursts (8 calls each); 0 = off
# Position overlay (turn on once the daily quota is lifted): lines read from the per-line position feed
# SUBWAY_LIVE_POSITION_LINES=0      # most-visible lines per request; 0 = off (also turns off focus=)
# SUBWAY_LIVE_POSITION_SECONDS=25   # refresh of those lines
# SUBWAY_LIVE_FOCUS_SECONDS=15      # refresh of the line of a train being followed
# SUBWAY_LIVE_POSITION_BUDGET=3000  # at most this many overlay calls a day, however many lines are viewed
# SUBWAY_LIVE_RESPONSE_SECONDS=2    # identical /live requests within this window share one response
# 회원 로그인(카카오 · 구글 · Apple) · 승차권 — server/config.py MemberConfig. 제공자 값이 하나도 없으면 회원 기능 전체가 꺼진다
# (화면은 로그인 줄을 숨긴다). 값은 이 예시에 적지 말고 /etc/subway-live.env 에만. 바꾼 뒤 systemctl restart subway-live
# 카카오 디벨로퍼스: 카카오 로그인 켜기 · 리다이렉트 URI https://syung.novum-lab.com/api/auth/kakao/callback · 동의 항목은 닉네임(profile_nickname)만
# KAKAO_LOGIN=1                  # 1 이어야 카카오 로그인이 켜진다(아래 두 값도 1 일 때만 읽는다)
# KAKAO_LOGIN_CLIENT_ID=         # 앱의 REST API 키. 비우면 장소 검색의 KAKAO_REST_KEY 를 쓴다
# KAKAO_CLIENT_SECRET=           # 앱의 클라이언트 시크릿(REST API 키에 기본으로 켜져 있다)
# GOOGLE_CLIENT_ID=              # 구글: 둘 다 있어야 켜진다. 리다이렉트 URI <SYUNG_PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=               # Apple: Services ID, 시크릿과 둘 다 있어야 켜진다. 리다이렉트 URI <SYUNG_PUBLIC_URL>/api/auth/apple/callback
# APPLE_CLIENT_SECRET=           # 미리 만든 ES256 JWT(6개월마다 새로 만든다)
# SYUNG_PUBLIC_URL=https://syung.novum-lab.com   # 리다이렉트 URI 의 앞부분(제공자 콘솔에 등록한 것과 같아야 한다, 기본값)
# SYUNG_MEMBER_DB=/var/lib/subway-live/members.sqlite3   # 회원 · 승차권 DB(기본값). 백업 장치는 아직 없다
