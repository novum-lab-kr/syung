[Unit]
Description=Nol-meok subway live sample recorder (reads the local proxy cache; no extra API calls)
After=subway-live.service
Wants=subway-live.service

[Service]
Type=simple
WorkingDirectory=/root/syung
ExecStart=/usr/bin/python3 /root/syung/pipeline/sample_live_positions.py 0 /var/lib/subway-live/samples
Restart=on-failure
RestartSec=30
User=root

[Install]
WantedBy=multi-user.target
