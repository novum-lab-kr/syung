    "7": "7px",
    "8": "8px",
    "9": "9px",
    "10": "10px",
    "12": "12px",
    "14": "14px",
    "15": "15px",
    "16": "16px",
    "18": "18px",
    "22": "22px",
    "27": "27px",
    "pill": "999px",
    "circle": "50%"
  },
  "shadow": {
    "$prefix": "shadow-",
    "DEFAULT": {
      "light": "0 3px 0 rgba(20,20,20,.08),0 6px 18px rgba(60,50,0,.10)",
      "dark": "0 3px 0 rgba(0,0,0,.35),0 6px 18px rgba(0,0,0,.35)"
    },
    "edge": "0 2px 0 rgba(20,20,20,.15)",
