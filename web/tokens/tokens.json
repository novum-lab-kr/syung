    "12.5": "12.5px",
    "13": "13px",
    "13.5": "13.5px",
    "14": "14px",
    "14.5": "14.5px",
    "15": "15px",
    "16": "16px",
    "17": "17px",
    "18": "18px",
    "19": "19px",
    "20": "20px",
    "21": "21px",
    "22": "22px",
    "24": "24px",
    "26": "26px",
    "36": "36px"
  },
  "weight": {
    "$prefix": "weight-",
    "regular": "400",
    "medium": "500",
    "semibold": "600",
    "bold": "700",
    "extrabold": "800"
  },
  "space": {
    "$prefix": "space-",
    "1": "4px",
    "2": "8px",
