// 광화문광장 동상 둘(이순신 장군 · 세종대왕)을 곡면 메시로 짓는다(monument_curves.mts). 구역 파일 monuments_gyeongbok.mts 가 부른다(지연 로드).
// 방향 · 규칙: 모델 좌표는 동(+x) · 북(+y), 두 동상 모두 남쪽(−y)을 본다(OSM direction 180°). 높이는 받침 윗면을 0 으로 쓰다 w.dz 로 올린다.
// 모양은 사진(Wikimedia Commons)으로 맞췄다 — 얼굴 · 갑옷 문양 · 의자 조각 · 새김 글자는 출처 없이 못 그려 단순하게 둔다. 값마다 "근사"는 사진 비례로 맞춘 값이다.
import { MeshWriter, K } from './monument_parts.mts';
import type { V3 } from './monument_parts.mts';
import { body, ellipsoid, tube, loft, rotate, torus, bowl, cup } from './monument_curves.mts';
import type { Knot, Pose } from './monument_curves.mts';

// 자세가 든 상자(책 · 판): 가운데 · 반크기 · 자세 — 곡면이 아닌 판은 이 상자로
function slab(w:MeshWriter, center:V3, half:V3, kind:number, pose:Pose):void {
  const P = (x:number, y:number, z:number):V3 => { const p = rotate([x * half[0], y * half[1], z * half[2]], pose); return [center[0] + p[0], center[1] + p[1], center[2] + p[2]] };
  const N = (x:number, y:number, z:number):V3 => rotate([x, y, z], pose);
  for (const [axis, sign] of [[0, -1], [0, 1], [1, -1], [1, 1], [2, -1], [2, 1]] as const) {
    const u = (axis + 1) % 3, v = (axis + 2) % 3, at = (a:number, b:number):V3 => { const c = [0, 0, 0]; c[axis] = sign; c[u] = a; c[v] = b; return P(c[0]!, c[1]!, c[2]!) };
    const n = [0, 0, 0]; n[axis] = sign;
    w.quad(at(-1, -1), at(1, -1), at(1, 1), at(-1, 1), kind, N(n[0]!, n[1]!, n[2]!));
  }
}

// ── 이순신 장군 동상 ──────────────────────────────────────────────────────────────────────────────────────────
// 근거: 동상 6.5 m · 받침 10.5 m, 오른손에 칼, 앞에 거북선 모형과 군용 북 모형 둘, 2010 보수로 청동색과 녹색을 섞은 색, 1968 김세중 작(위키백과 「Statue of Admiral Yi Sun-sin」 — 거북선 모형 · 북 모형 둘을 적은 문장). 방향 남쪽(OSM node 2653074012).
// 옆의 12·23 분수는 물이라 그리지 않는다. 모습: Commons 「Yi Sun-sin 4」(CC0) · 「Yi Sun-sin statue and 12.23 Fountain」(CC BY-SA 3.0) — 투구 본체 위의 가는 꼭지 · 넓은 어깨 · 발목까지 내려오는 긴 갑옷 ·
// 오른손(서쪽)으로 짚은 칼집 있는 긴 칼(칼끝은 받침 위) · 왼손은 허리 쪽. 받침은 사진에서 재면 폭이 동상 높이의 절반을 넘는 곧은 돌기둥이다(아래 3.9 × 3.1 → 위 3.2 × 2.7 m — 근사).
// 거북선 · 북의 크기와 자리는 사진 비례로 맞춘 값(근사) — 새김 글자 · 부조 · 얼굴 세부는 그리지 않는다.
const YI = { shaftTop: 10.5, plinth: .5 };
export function buildYiSunsin(w:MeshWriter):void {
  const z0 = YI.shaftTop;
  // 받침: 낮은 두 단 + 낮은 대 + 곧은 석주 + 머리 판석
  w.box(-5.2, 5.2, -5.2, 5.2, 0, .3, K.stone, { bottom: true });
  w.box(-4.2, 4.2, -4.2, 4.2, .3, YI.plinth, K.stone, { bottom: true });
  w.box(-2.6, 2.6, -2.1, 2.1, YI.plinth, 1.4, K.stone, { bottom: true });
  w.frustum(0, 0, 1.95, 1.55, 1.4, 1.6, 1.35, z0 - .3, K.stone, { bottom: true });
  w.box(-1.8, 1.8, -1.5, 1.5, z0 - .3, z0, K.stone, { bottom: true });
  // 앞 아래: 거북선 모형(선체 + 둥근 등판 + 용머리)과 군용 북 모형 둘(가로 통 + 가죽 면 + 받침) — 크기 · 자리는 근사
  const sy = -3.1, sz = YI.plinth;
  w.box(-1.0, 1.0, sy - 1.9, sy + 1.9, sz, sz + .15, K.stone, { bottom: true });
  w.frustum(0, sy, .55, 1.5, sz + .15, .9, 1.75, sz + .55, K.bronze, { bottom: true });   // 선체: 아래가 좁고 위가 벌어진 배
  w.frustum(0, sy, .78, 1.45, sz + .55, .42, .95, sz + .95, K.bronze, { bottom: true });   // 등판: 낮게 덮은 거북 등딱지
  ellipsoid(w, [0, sy, sz + .95], [.2, .3, .08], K.trim, {}, [4, 8]);   // 등판 위 장대 자리
  tube(w, [[0, sy - 1.75, sz + .5, .13, .13], [0, sy - 2.0, sz + .7, .13, .13], [0, sy - 2.18, sz + .88, .15, .17]], K.bronze, { sides: 8, cap: 2 });   // 뱃머리 용머리
  ellipsoid(w, [0, sy + 1.78, sz + .5], [.28, .08, .22], K.bronze, {}, [4, 8]);   // 고물 키
  for (const x of [-2.6, 2.6]) {
    const dy = -3.0;
    w.box(x - .5, x + .5, dy - .18, dy + .18, sz, sz + .22, K.stone, { bottom: true });   // 북 받침
    tube(w, [[x - .42, dy, sz + .72, .34, .34], [x, dy, sz + .72, .46, .46], [x + .42, dy, sz + .72, .34, .34]], K.bronze, { sides: 16, steps: 8, cap: 0 });   // 가로 통
    for (const side of [-1, 1]) tube(w, [[x + side * .44, dy, sz + .72, .35, .35], [x + side * .48, dy, sz + .72, .35, .35]], K.trim, { sides: 16, steps: 1, cap: 0 });   // 가죽 면
  }
  w.dz = z0;
  // 긴 갑옷: 발목에서 퍼지는 옷자락 · 큰 면(세로 가닥 · 가로 단) · 앞 트임 → 허리 → 가슴 → 어깨 → 목
  const fold = (v:number, u:number) => {
    const tier = ((v * 4) % 1) * .07 * (1 - v), groove = -.09 * Math.exp(-(((u - .75) / .028) ** 2)) * (1 - v * .6), panel = .035 * Math.sin(u * Math.PI * 2 * 5) * (1 - v) ** 1.2;
    return v < .62 ? tier + groove + panel : 0;
  };
  body(w, [[0, 0, .3, 1.04, .72], [0, 0, 1.1, .95, .66], [0, 0, 2.0, .83, .58], [0, 0, 2.75, .66, .5], [0, 0, 3.05, .6, .46], [0, 0, 3.5, .76, .5], [0, 0, 4.0, .93, .52], [0, 0, 4.4, .78, .44], [0, 0, 4.64, .3, .28]], K.bronze, { cols: 32, rows: 36, fold });
  body(w, [[0, 0, 2.86, .68, .54], [0, 0, 3.06, .68, .54]], K.bronze, { cols: 28, rows: 2 });   // 허리띠
  for (const x of [-.42, .42]) ellipsoid(w, [x, -.5, .12], [.3, .6, .17], K.bronze, { yaw: x * .3 }, [6, 10]);   // 두 발(앞코가 나온다)
  // 어깨 갑(넓게 덮고 끝이 아래로 처진다) · 옷깃
  for (const side of [-1, 1]) ellipsoid(w, [side * 1.0, 0, 4.28], [.55, .44, .27], K.bronze, { roll: side * .45 }, [8, 14]);
  ellipsoid(w, [0, -.04, 4.55], [.44, .36, .13], K.bronze, {}, [6, 12]);
  // 오른팔(서쪽): 소매가 팔꿈치 쪽으로 퍼지고 앞으로 굽혀 칼자루를 쥔다 — 칼은 손 앞(서쪽 앞)에서 받침을 짚는다
  tube(w, [[-1.0, 0, 4.15, .32, .32], [-1.4, -.05, 3.7, .3, .3], [-1.58, -.15, 3.3, .3, .28], [-1.66, -.5, 3.45, .22, .2], [-1.66, -.68, 3.62, .15, .15]], K.bronze, { sides: 12 });
  ellipsoid(w, [-1.66, -.7, 3.62], [.17, .17, .19], K.bronze, {}, [6, 10]);   // 칼 쥔 주먹
  const sx = -1.66, syw = -.7;
  // 장검: 납작한 칼집(칼날 쪽이 얇다) · 칼집 끝 쇠 · 칼집 입구 · 큰 코등이 · 칼자루 · 자루 머리 — 칼집이 지팡이처럼 둥글고 가늘지 않게 단면을 납작 · 굵게
  tube(w, [[sx, syw, .05, .12, .07], [sx, syw, .45, .15, .085], [sx, syw, 2.6, .15, .09], [sx, syw, 3.1, .13, .085], [sx, syw, 3.3, .13, .085]], K.bronze, { sides: 10, steps: 12, cap: 1 });
  tube(w, [[sx, syw, 3.55, .075, .075], [sx, syw, 4.2, .09, .09], [sx, syw, 5.0, .08, .08]], K.bronze, { sides: 10, steps: 6, cap: 2 });   // 자루
  ellipsoid(w, [sx, syw, 3.3], [.36, .13, .07], K.bronze, {}, [6, 12]);   // 큰 코등이
  ellipsoid(w, [sx, syw, 5.1], [.14, .12, .12], K.bronze, {}, [6, 8]);   // 자루 머리
  // 왼팔(동쪽): 팔꿈치를 밖으로 내밀고 손은 허리띠 쪽
  tube(w, [[1.0, 0, 4.15, .32, .32], [1.4, 0, 3.8, .3, .3], [1.64, -.05, 3.35, .28, .28], [1.25, -.3, 3.1, .2, .19], [.82, -.46, 2.98, .15, .15]], K.bronze, { sides: 12 });
  ellipsoid(w, [.78, -.5, 2.96], [.17, .15, .15], K.bronze, {}, [6, 10]);
  // 머리: 얼굴(단순한 타원) · 짧은 수염 · 투구(둥근 본체 + 가는 꼭지) · 옆 · 뒤 목가리개
  ellipsoid(w, [0, -.07, 5.0], [.27, .3, .36], K.bronze, {}, [10, 14]);
  ellipsoid(w, [0, -.34, 4.98], [.05, .08, .12], K.bronze, { pitch: .15 }, [5, 8]);   // 코
  tube(w, [[0, -.28, 4.76, .1, .05], [0, -.31, 4.6, .075, .04]], K.bronze, { sides: 8, cap: 2 });   // 짧은 수염
  body(w, [[0, .02, 5.1, .47, .47], [0, .02, 5.28, .43, .45], [0, .02, 5.58, .39, .41], [0, .02, 5.84, .26, .28], [0, .02, 6.02, .1, .1]], K.bronze, { cols: 20, rows: 14 });   // 본체(위로 갈수록 둥글게 모인다)
  tube(w, [[0, .02, 5.98, .05, .05], [0, .02, 6.22, .035, .035], [0, .02, 6.46, .02, .02]], K.bronze, { sides: 6, steps: 4, cap: 1 });   // 가는 꼭지
  ellipsoid(w, [0, .02, 6.03, ], [.1, .1, .07], K.bronze, {}, [4, 8]);   // 꼭지 밑동
  // 목가리개: 뒤와 옆을 덮으며 아래로 벌어지는 부채꼴(열린 면 — 뒤쪽 반원)
  loft(w, 6, 12, (v, u) => { const theta = u * Math.PI, flare = 1 + (1 - v) * .5; return [Math.cos(theta) * .44 * flare, Math.sin(theta) * .44 * flare + .02, 4.64 + v * .56] }, K.bronze, { closed: false });
  w.dz = 0;
}

// ── 세종대왕 동상 ─────────────────────────────────────────────────────────────────────────────────────────────
// 근거(공식): 서울미래유산 「세종로 세종대왕 동상」(futureheritage.seoul.go.kr htNo=393) — 동상 높이 6.2 m · 폭 4.3 m · 기단 높이 4.2 m · 총 10.4 m, 남쪽을 향한 좌상, 앞에 혼천의 · 측우기 · 해시계(앙부일구), 뒤에 집현전학사도 부조. 2009-10 건립, 김영원 작.
// 모습: Commons 「Statue of King Sejong」(CC BY-SA 2.0 — 정면) · 「King sejong the great gwanghwamun square police-859145」(CC0 — 밤 · 받침) — 높은 의자 · 어깨에서 의자 앞까지 한 덩어리로 흘러내리는 곤룡포 ·
// 오른손(서쪽)을 펴 올리고 왼손(동쪽)은 책을 받친다 · 익선관(둥근 관체 + 뒤쪽에 위로 솟은 두 날개) · 수염. 의자 조각 · 곤룡포 용 무늬 · 얼굴 세부 · 한글 새김 · 뒤 부조는 그리지 않는다. 기단의 가로 · 세로(아래 8.5 × 6.2 → 위 5.4 × 4.2 m)와 앞 모형의 크기는 사진 비례(근사).
// 큰 비례(근사): 의자 폭 4.3 m(공식) · 의자 등받이 위 3.6 m · 머리(관 빼고) 높이 약 1.2 m · 관 위 끝 6.2 m(공식).
const SEJONG = { baseTop: 4.2, total: 10.4 };
export function buildSejong(w:MeshWriter):void {
  const zb = SEJONG.baseTop, G = K.gilt;
  w.frustum(0, 0, 4.25, 3.1, 0, 2.7, 2.1, zb, K.stone, { bottom: true });
  // 앞 땅의 모형 셋(받침 위): 앙부일구(오목한 그릇 + 비스듬한 바늘) · 측우기(속 빈 원통) · 혼천의(열린 고리 셋 + 가운데 공) — 크기 · 자리는 근사
  for (const [x, kind] of [[-3.2, 0], [0, 1], [3.2, 2]] as const) {
    const y = -5.4;
    w.box(x - .55, x + .55, y - .55, y + .55, 0, .85, K.stone, { bottom: true });
    if (kind === 0) {
      bowl(w, [x, y, 1.45], .55, .07, G, [6, 20]);   // 오목한 그릇(가장자리 높이 1.45)
      tube(w, [[x - .02, y + .3, 1.42, .025, .025], [x - .02, y - .02, 1.07, .025, .025], [x - .02, y - .3, 1.0, .025, .025]], G, { sides: 6, steps: 4, cap: 1 });   // 그릇 안을 가로지르는 바늘(근사)
    } else if (kind === 1) {
      cup(w, [x, y, .85], .27, .045, .7, G, 20);   // 위가 뚫린 통(마개 없음 · 안쪽 바닥이 보인다)
    } else {
      ellipsoid(w, [x, y, 1.5], [.14, .14, .14], G, {}, [6, 10]);
      torus(w, [x, y, 1.5], .46, .028, G, {}, [4, 24]);   // 적도 고리
      torus(w, [x, y, 1.5], .42, .028, G, { pitch: Math.PI / 2 }, [4, 24]);   // 자오 고리
      torus(w, [x, y, 1.5], .38, .028, G, { pitch: Math.PI / 2, yaw: Math.PI / 2 }, [4, 24]);   // 또 하나의 자오 고리
      torus(w, [x, y, 1.5], .5, .03, G, { roll: .6 }, [4, 24]);   // 기운 고리
    }
  }
  w.dz = zb;
  // 의자: 발판 · 앉는 단 · 양옆 벽(앞쪽에 용머리 손잡이) · 뒤판 — 조각은 그리지 않고 판 형태로 단순화한다
  w.box(-1.5, 1.5, -2.2, -1.1, 0, .6, G, { bottom: true });
  w.box(-1.78, 1.78, -1.1, 1.4, 0, 1.15, G, { bottom: true });
  for (const side of [-1, 1]) {
    w.box(Math.min(side * 1.78, side * 2.15), Math.max(side * 1.78, side * 2.15), -1.1, 1.4, 0, 2.9, G, { bottom: true });
    w.box(Math.min(side * 1.7, side * 2.23), Math.max(side * 1.7, side * 2.23), -1.15, 1.4, 2.9, 3.12, G, { bottom: true });   // 팔걸이
    tube(w, [[side * 1.97, -1.1, 3.05, .11, .11], [side * 2.03, -1.3, 3.25, .11, .11], [side * 2.05, -1.4, 3.4, .13, .13]], G, { sides: 8, cap: 2 });   // 용머리 손잡이(근사: 곡선 끝에 둥근 머리)
    ellipsoid(w, [side * 2.05, -1.48, 3.44], [.17, .21, .15], G, {}, [6, 10]);
  }
  w.box(-2.15, 2.15, 1.0, 1.4, 0, 3.7, G, { bottom: true });   // 등받이
  // 곤룡포: 무릎 두 봉우리 없이 어깨 → 허리 → 무릎 → 발까지 한 덩어리로 넓게 흘러내려 밑단이 퍼진다(세로 주름)
  const drape = (v:number, u:number) => .05 * Math.sin(u * Math.PI * 2 * 11 + v * 1.5) * (1 - v) ** 1.2;
  body(w, [[0, -.95, .75, 1.65, 1.3], [0, -1.0, 1.1, 1.62, 1.28], [0, -.85, 1.7, 1.52, 1.1], [0, -.5, 2.3, 1.25, .85]], G, { cols: 40, rows: 20, fold: drape });   // 무릎 위 · 앞으로 흘러내린 자락
  body(w, [[0, -.05, 1.9, 1.35, .95], [0, -.02, 2.7, 1.02, .72], [0, 0, 3.15, .98, .62], [0, 0, 3.85, 1.2, .6], [0, 0, 4.2, 1.1, .5], [0, 0, 4.45, .4, .34]], G, { cols: 36, rows: 22, fold: (v, u) => v < .5 ? drape(v, u) * .6 : 0 });   // 몸통: 허리에서 좁아지고 어깨에서 넓어진다
  body(w, [[0, -.02, 2.88, 1.05, .74], [0, -.02, 3.06, 1.05, .74]], G, { cols: 32, rows: 2 });   // 허리띠
  ellipsoid(w, [0, -.35, 4.2], [.62, .22, .2], G, {}, [6, 14]);   // 옷깃(둥근 깃)
  // 오른팔(서쪽): 큰 소매가 어깨에서 팔꿈치로 처지고 아래팔은 앞으로 올라 손바닥을 편다
  tube(w, [[-1.05, 0, 4.0, .4, .4], [-1.5, -.1, 3.45, .46, .44], [-1.62, -.3, 3.1, .48, .46]], G, { sides: 14 });
  ellipsoid(w, [-1.65, -.4, 2.8], [.45, .4, .65], G, { roll: -.1 }, [8, 14]);   // 아래로 처지는 큰 소매
  tube(w, [[-1.55, -.25, 3.4, .32, .32], [-1.52, -.6, 4.1, .24, .24], [-1.46, -.95, 4.75, .18, .18]], G, { sides: 12 });   // 올린 아래팔(손끝이 얼굴 높이 5.0 m 까지 — 사진)
  ellipsoid(w, [-1.45, -1.05, 4.98], [.2, .06, .26], G, { pitch: -.15 }, [6, 12]);   // 편 손바닥(앞을 본다)
  for (const [fx, fz] of [[-.14, .3], [-.05, .38], [.05, .38], [.14, .3]] as const) tube(w, [[-1.45 + fx * .6, -1.07, 5.12, .035, .035], [-1.45 + fx, -1.08, 5.12 + fz * .6, .028, .028], [-1.45 + fx * 1.2, -1.09, 5.12 + fz, .022, .022]], G, { sides: 6, steps: 3, cap: 1 });   // 펴 든 손가락(근사)
  tube(w, [[-1.62, -1.04, 4.9, .04, .04], [-1.7, -1.06, 5.02, .03, .03]], G, { sides: 6, steps: 2, cap: 1 });   // 엄지
  // 왼팔(동쪽): 소매가 처지고 손이 무릎 위 책을 받친다
  tube(w, [[1.05, 0, 4.0, .4, .4], [1.5, -.1, 3.4, .45, .43], [1.58, -.35, 2.95, .42, .4], [1.2, -.9, 2.7, .22, .2], [.95, -1.15, 2.6, .15, .15]], G, { sides: 14 });
  ellipsoid(w, [1.7, -.25, 2.55], [.38, .34, .6], G, { roll: .1 }, [8, 14]);
  ellipsoid(w, [.93, -1.2, 2.58], [.17, .13, .09], G, {}, [5, 10]);   // 책을 받친 손
  // 책: 펼친 두 쪽(가운데가 살짝 접히고 바깥이 높다) — 크기 · 기울기는 근사
  slab(w, [1.3, -1.3, 2.62], [.55, .4, .035], G, { roll: .38, yaw: .1 });
  slab(w, [.75, -1.25, 2.55], [.52, .4, .035], G, { roll: .16, yaw: .1 });
  // 머리(관을 빼고 높이 약 1.2 m): 굵은 목 · 얼굴 · 코 · 귀 · 짧은 수염 · 익선관(둥근 관체 + 뒤쪽 좌우로 솟은 넓고 납작한 두 날개)
  tube(w, [[0, 0, 4.2, .34, .32], [0, 0, 4.6, .32, .3]], G, { sides: 12, cap: 1 });   // 목
  ellipsoid(w, [0, -.05, 5.0, ], [.5, .52, .6], G, {}, [10, 16]);
  ellipsoid(w, [0, -.52, 4.93], [.08, .12, .17], G, { pitch: .15 }, [5, 8]);   // 코
  for (const side of [-1, 1]) ellipsoid(w, [side * .5, -.02, 5.0], [.06, .1, .17], G, {}, [5, 8]);   // 귀
  ellipsoid(w, [0, -.4, 4.62], [.26, .12, .24], G, {}, [6, 12]);   // 짧고 넓은 수염(턱 아래 — 가슴으로 내려오는 막대는 그리지 않는다)
  body(w, [[0, .06, 5.3, .56, .6], [0, .08, 5.6, .56, .6], [0, .1, 5.95, .46, .5], [0, .1, 6.2, .22, .26]], G, { cols: 22, rows: 12 });   // 관체(둥글고 뒤로 약간 길다)
  for (const side of [-1, 1]) ellipsoid(w, [side * .2, .66, 5.74], [.21, .045, .22], G, { yaw: side * .12 }, [8, 14]);   // 관 뒤쪽에 붙은 둥글고 납작한 날개판(끝이 둥글고 관 꼭대기 아래 — 정면에서 귀처럼 벌어지지 않는다)
  w.dz = 0;
}
